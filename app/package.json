{
  "name": "midiremap-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "gen:i18n": "node scripts/gen-i18n.ts",
    "fmt:ftl": "node scripts/format-ftl.ts",
    "predev": "npm run gen:i18n && npm run build:wasm",
    "dev": "vite",
    "prebuild": "npm run gen:i18n && npm run build:wasm",
    "build": "npm run typecheck --ignore-scripts && npm run build:app",
    "build:app": "vite build",
    "build:site": "npm run build && npm run site",
    "site": "cargo run --manifest-path ../Cargo.toml -p midiremap-site --locked -- dist",
    "preview": "vite preview",
    "prelint": "npm run gen:i18n",
    "lint": "eslint . --max-warnings 0",
    "pretest": "npm run gen:i18n",
    "test": "vitest run",
    "pretypecheck": "npm run gen:i18n",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "screenshot": "playwright test -c playwright.screenshot.config.ts",
    "size": "node scripts/check-size.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fluent/bundle": "^0.19.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluent/syntax": "^0.19.0",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "binaryen": "^132.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fontaine": "1.0.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "midi-file": "^1.2.4",
    "postcss": "8.5.29",
    "pseudo-localization": "^3.1.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
